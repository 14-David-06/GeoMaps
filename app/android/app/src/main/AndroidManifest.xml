<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Ubicacion: es la razon de ser de la app. FINE es la precisa; COARSE va
         igual porque Android 12+ deja que la persona conceda solo la
         aproximada, y sin declararla la app ni recibe esa opcion. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Grabar el viaje de un camion con la pantalla apagada. El servicio en
         primer plano es el de geolocator (tipo `location`), con una
         notificacion fija mientras graba: sin el, Android corta la ubicacion
         a los pocos minutos de apagar la pantalla y el recorrido queda con un
         hueco. Android 14 exige el permiso por tipo de servicio; 13 pide
         POST_NOTIFICATIONS para que la notificacion se vea. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Escanear el QR de vueltas pendientes (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Bajar teselas y sincronizar. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Actualizaciones: el APK se reparte directo, sin Play Store, y la app
         baja e instala la version nueva por su cuenta (ota_update). Android
         pide a la persona permitir "instalar de esta fuente" la primera vez.
         El .aab de Play no lo trae: lo quita src/play/AndroidManifest.xml. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- ota_update declara estas dos y no hacen falta: INSTALL_PACKAGES es solo
         para apps de sistema, y el APK se baja al almacenamiento interno. -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <application
        android:label="GeoMaps"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Le pasa el APK descargado al instalador de Android. -->
        <provider
            android:name="sk.fourq.otaupdate.OtaUpdateFileProvider"
            android:authorities="${applicationId}.ota_update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- La voz de las indicaciones (flutter_tts). Desde Android 11 una app
             no ve los servicios de otras si no los declara, y sin esto el
             telefono contesta que no tiene sintetizador de voz. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
